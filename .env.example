# GrokifyOS environment (copy to .env and fill in)

GROKIFY_APP_NAME=GrokifyOS
GROKIFY_SITE_URL=https://grokifyos.example.com
GROKIFY_WEB_BASE=

# MySQL (dedicated DB — never reuse production grokpot DB)
GROKIFY_DB_HOST=127.0.0.1
GROKIFY_DB_PORT=3306
GROKIFY_DB_NAME=grokifyos
GROKIFY_DB_USER=grokifyos
GROKIFY_DB_PASS=change-me

# Agent bridge (HTTP + models/health; own instance in production)
GROKIFY_BRIDGE_URL=http://127.0.0.1:8876
GROKIFY_BRIDGE_HEALTH=http://127.0.0.1:8876/health
# Public WebSocket path (Apache/nginx proxies this to the bridge)
GROKIFY_WS_PATH=/grokify-ws/
# Shared secret for short-lived WS tokens (set a long random string)
GROKIFY_WS_AUTH_SECRET=
GROKIFY_SECRETS_PEPPER=

# Grok Build OAuth auth.json path (from `grok login`) — real usage only, no mocks
# GROKIFY_GROK_AUTH_JSON=/path/to/auth.json
# GROKIFY_GROK_BILLING_URL=https://cli-chat-proxy.grok.com/v1/billing?format=credits
