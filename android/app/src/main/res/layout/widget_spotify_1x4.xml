<?xml version="1.0" encoding="utf-8"?>
<!--
  Spotify home strip: art + meta on top, transport always on-widget (prev / play / next).
  Two rows so buttons never get clipped by title text on narrow cells.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/spotify_album_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_bg_panel" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:src="@drawable/widget_bg_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <!-- Row 1: art + title/artist (tap → open app) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/spotify_artist_thumb"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_thumb_ring"
                android:contentDescription="Artist"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_ic_music" />

            <LinearLayout
                android:id="@+id/spotify_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/spotify_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Nothing playing"
                    android:textColor="#E8EDF7"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/spotify_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Spotify · Live DJ controls"
                    android:textColor="#8B95A8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: transport always visible on-widget -->
        <LinearLayout
            android:id="@+id/spotify_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/spotify_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_circle"
                android:contentDescription="Previous"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_prev" />

            <ImageView
                android:id="@+id/spotify_btn_play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_btn_circle"
                android:contentDescription="Play or pause"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />

            <ImageView
                android:id="@+id/spotify_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_btn_circle"
                android:contentDescription="Next"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/spotify_btn_like"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_btn_circle"
                android:contentDescription="Like"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_heart" />

            <ImageView
                android:id="@+id/spotify_btn_more"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_btn_circle"
                android:contentDescription="More like this"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_more" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
