<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed + lock-screen: art · title/artist · always-visible icon transport.
  No theme attrs on icon tints — RemoteViews often fails to resolve them (icons
  vanish; only the mint play/pause stayed visible).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_spotify_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingTop="2dp"
    android:paddingEnd="0dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/notif_spotify_album"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Album art"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_ic_music" />

    <LinearLayout
        android:id="@+id/notif_spotify_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_spotify_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Track"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notif_spotify_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artist"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notif_spotify_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Fixed-width transport so prev/play/next never get measured to 0. -->
    <LinearLayout
        android:id="@+id/notif_spotify_transport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:minWidth="112dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_spotify_btn_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/notif_btn_bg"
            android:contentDescription="Previous"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/notif_ic_prev" />

        <ImageView
            android:id="@+id/notif_spotify_btn_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/notif_btn_bg"
            android:contentDescription="Play or pause"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/notif_ic_play" />

        <ImageView
            android:id="@+id/notif_spotify_btn_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/notif_btn_bg"
            android:contentDescription="Next"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/notif_ic_next" />
    </LinearLayout>
</LinearLayout>
