<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded shade: art + meta, centered icon transport, optional Live DJ queue.
  Hardcoded icon tints applied in code — no theme attrs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_spotify_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="4dp"
    android:paddingEnd="0dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/notif_spotify_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_spotify_album"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Album art"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_ic_music" />

        <LinearLayout
            android:id="@+id/notif_spotify_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_spotify_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Track"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/notif_spotify_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Artist"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/notif_spotify_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_spotify_transport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_spotify_btn_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notif_btn_bg"
            android:contentDescription="Previous"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/notif_ic_prev" />

        <ImageView
            android:id="@+id/notif_spotify_btn_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/notif_btn_bg"
            android:contentDescription="Play or pause"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/notif_ic_play" />

        <ImageView
            android:id="@+id/notif_spotify_btn_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notif_btn_bg"
            android:contentDescription="Next"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/notif_ic_next" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_spotify_queue_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp"
        android:text="UP NEXT"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/notif_spotify_queue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/notif_spotify_queue_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="No queue — open Live DJ to build one"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
