<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/place_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/widget_place_card"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/place_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Place"
                android:textColor="#E8EDF7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/place_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="—"
                android:textColor="#A78BFA"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/place_btn_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_circle"
            android:contentDescription="Toggle place armed"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_toggle_on" />

        <ImageButton
            android:id="@+id/place_btn_maps"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_circle"
            android:contentDescription="Open in maps"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_maps" />
    </LinearLayout>

    <TextView
        android:id="@+id/place_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text=""
        android:textColor="#8B95A8"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/place_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/place_btn_open_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:text="Open app"
            android:textColor="#22D3EE"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/place_btn_open_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip"
            android:text="Image"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
