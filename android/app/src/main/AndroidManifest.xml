<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Location (precise GPS + network) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Bluetooth device tracking -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Camera / mic / speech -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Storage / media (scoped + legacy) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Notifications / screenshots / assistant -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates / Samsung Live Notifications (lockscreen promote) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Install OTA APKs from Grokify update API -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <!-- Package visibility for Place Notes picker + Spotify controller -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        <package android:name="com.spotify.music" />
        <package android:name="com.spotify.lite" />
    </queries>

    <application
        android:name=".GrokifyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Grokify"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.Grokify">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Spotify OAuth PKCE — custom scheme (bounce page / intent://) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="grokifyos"
                    android:host="spotify-callback" />
            </intent-filter>
            <!-- Spotify OAuth — verified App Link (opens app directly from HTTPS redirect) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="grokifyos.grokpot.io"
                    android:path="/spotify-callback.php" />
            </intent-filter>
            <!-- Assistant / voice entry -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.speech.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Android Auto / car projection hook -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="com.google.android.gms.car.application"
                android:resource="@xml/automotive_app_desc" />
        </activity>

        <service
            android:name=".service.GrokifyForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location|microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ai_assistant_bridge" />
        </service>

        <service
            android:name=".apps.SpotifyControllerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="lockscreen_media_remote_control" />
        </service>

        <service
            android:name=".apps.SpotifyLiveDjService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="spotify_live_ai_dj_playback_watch" />
        </service>

        <service
            android:name=".apps.LocationNoteMonitorService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".service.GrokifyNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".apps.LocationNoteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.grokify.os.PLACE_NOTE_LOCATION" />
                <action android:name="io.grokify.os.PLACE_NOTE_OPEN" />
                <action android:name="io.grokify.os.PLACE_NOTE_OPEN_APP" />
                <action android:name="io.grokify.os.PLACE_NOTE_OPEN_IMAGE" />
                <action android:name="io.grokify.os.PLACE_NOTE_TOGGLE_MONITOR" />
                <action android:name="io.grokify.os.PLACE_NOTE_TOGGLE_NOTE" />
                <action android:name="io.grokify.os.PLACE_NOTE_REFRESH" />
                <action android:name="io.grokify.os.PLACE_NOTE_PIN_HERE" />
                <action android:name="io.grokify.os.PLACE_NOTE_OPEN_MAPS" />
                <action android:name="io.grokify.os.PLACE_NOTE_STOP_MONITOR" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".apps.SpotifyControllerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.grokify.os.SPOTIFY_PREV" />
                <action android:name="io.grokify.os.SPOTIFY_PLAY_PAUSE" />
                <action android:name="io.grokify.os.SPOTIFY_NEXT" />
                <action android:name="io.grokify.os.SPOTIFY_STOP" />
                <action android:name="io.grokify.os.SPOTIFY_LIKE_TOGGLE" />
                <action android:name="io.grokify.os.SPOTIFY_MORE_LIKE" />
                <action android:name="io.grokify.os.SPOTIFY_PLAY_URI" />
                <action android:name="io.grokify.os.SPOTIFY_LIKE_URI" />
                <action android:name="io.grokify.os.SPOTIFY_MORE_LIKE_URI" />
                <action android:name="io.grokify.os.SPOTIFY_DJ_TOGGLE" />
                <action android:name="io.grokify.os.SPOTIFY_WIDGET_REFRESH" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (inner apps) -->
        <receiver
            android:name=".widgets.WifiScannerWidget"
            android:exported="true"
            android:label="@string/widget_wifi_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wifi_scanner" />
        </receiver>
        <receiver
            android:name=".widgets.BtScannerWidget"
            android:exported="true"
            android:label="@string/widget_bt_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bt_scanner" />
        </receiver>
        <receiver
            android:name=".widgets.PlaceNotesSmallWidget"
            android:exported="true"
            android:label="@string/widget_place_notes_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_place_notes" />
        </receiver>
        <receiver
            android:name=".widgets.SpaceXaiUsageWidget"
            android:exported="true"
            android:label="@string/widget_usage_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spacexai_usage" />
        </receiver>
        <receiver
            android:name=".widgets.SpotifySmallWidget"
            android:exported="true"
            android:label="@string/widget_spotify_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spotify_small" />
        </receiver>
        <receiver
            android:name=".widgets.PlaceNotesFullWidget"
            android:exported="true"
            android:label="@string/widget_place_notes_full_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_place_notes_full" />
        </receiver>

        <receiver
            android:name=".apps.SpotifyLiveDjReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.grokify.os.SPOTIFY_DJ_STOP" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".apps.SpaceXaiUsageAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.grokify.os.SPACEXAI_USAGE_ALERT_CHECK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
